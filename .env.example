# AI Sarthi Environment Configuration
# Do not commit the actual .env file to version control.

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="Healthcare AI SLM"

# Model Configuration
DEFAULT_MODEL=fine-tuned
OLLAMA_HOST=http://localhost:11434
HF_BASE_MODEL=microsoft/Phi-3-mini-4k-instruct
HF_ADAPTER_PATH=models/outputs

# Vector Store Configuration
CHROMA_PERSIST_DIR=vector_store
CHROMA_COLLECTION_NAME=healthcare_chunks

# Retrieval
DEFAULT_TOP_K=15
DEFAULT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
